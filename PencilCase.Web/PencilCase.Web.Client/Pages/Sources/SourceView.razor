@if (_children.Any())
{
    foreach (var child in _children.OrderBy(b => b.Properties.Order))
    {
        <MudPaper Elevation="0" Outlined="true">
            <div class="pa-4">
                <MudText>@child.Properties.Order</MudText>
                <MudMarkdown Value="@child.Name"/>
            </div>
        </MudPaper>
    }
}
else if(_loading)
{
    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-7"/>
}
else
{
    <div class="pa-12">
        <MudText Typo="Typo.h4" Align="Align.Center">This file is empty</MudText>
    </div>
}