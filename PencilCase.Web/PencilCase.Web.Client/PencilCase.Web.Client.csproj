<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.10"/>
        <PackageReference Include="MudBlazor" Version="7.15.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Pages\Blocks\" />
      <Folder Include="Pages\Notebooks\" />
      <Folder Include="Pages\Sources\" />
      <Folder Include="Pages\Topics\" />
      <Folder Include="Pages\Upload\" />
      <Folder Include="Services\LLM\" />
      <Folder Include="Services\Sources\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\PencilCase.Shared.Models\PencilCase.Shared.Models.csproj" />
    </ItemGroup>

</Project>
