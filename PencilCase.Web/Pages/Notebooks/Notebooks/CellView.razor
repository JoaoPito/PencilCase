@using MudBlazor.Extensions
@using PencilCase.Shared.Models.Notebooks
@using PencilCase.Web.Pages.Notebooks.Models

<MudCard Outlined="false" Elevation="4">
    <MudCardHeader Class="mud-background-gray">
        <CardHeaderAvatar>
            <MudStack Justify="Justify.FlexStart">
                <MudIcon Icon="@Icons.Material.Rounded.QuestionAnswer" Size="Size.Large"></MudIcon>
            </MudStack>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudTextField T="string" Class="ma-0" AutoGrow="true" Margin="Margin.Dense"
                          OnKeyDown="OnKeyDown" @ref="_inputTextField"
                          DebounceInterval="2500" MaxLength="250" Disabled="@_isLoading"
                          Typo="Typo.h6" Variant="Variant.Outlined" 
                          ValueChanged="OnInputValueChanged" Value="@Block!.Name">
            </MudTextField>
        </CardHeaderContent>
        <CardHeaderActions>
            <div class="mt-4 mx-4">
                @if (_isLoading)
                {
                    <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large"/>
                }
                else
                {
                    <MudFab StartIcon="@Icons.Material.Rounded.PlayArrow" Size="Size.Large"
                            Color="Color.Secondary" OnClick="OnSubmitClick">
                    </MudFab>
                }
            </div>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (_shownChild is not null && !_isLoading && !_childError)
        {
            <MudPaper Height="150" Outlined="false" Elevation="0" Class="pa-4">
                <MudText>@_shownChild.Name</MudText>
            </MudPaper>
        }
        else if (_isLoading)
        {
            <MudStack Spacing="1" StretchItems="StretchItems.None">
                <MudSkeleton Width="20%" Animation="Animation.Wave" />
                <MudSkeleton Width="100%" Animation="Animation.Wave" />
                <MudSkeleton Width="60%" Animation="Animation.Wave" />
            </MudStack>
        }
        else if (_childError)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center">
                <MudIcon Size="Size.Medium" Icon="@Icons.Material.Rounded.Warning" Color="Color.Warning"></MudIcon>
                <MudText Color="Color.Warning">An error has occured. Try reloading this cell in a couple of minutes.</MudText>
            </MudStack>
        }
    </MudCardContent>
    <MudCardActions>
        <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack"
                       Disabled="@(_shownChild == _loadedChildren.FirstOrDefault() || _isLoading)"
                       OnClick="OnArrowLeftClick">
            
        </MudIconButton>
        <MudIconButton Icon="@Icons.Material.Rounded.ArrowForward"
                       Disabled="@(_shownChild == _loadedChildren.LastOrDefault() || _isLoading)"
                       OnClick="OnArrowRightClick">
            
        </MudIconButton>
        <MudIconButton Icon="@Icons.Material.Rounded.Delete" Color="Color.Error"
                       Disabled="@_isLoading" OnClick="OnDeleteClick">
            
        </MudIconButton>
    </MudCardActions>
</MudCard>

