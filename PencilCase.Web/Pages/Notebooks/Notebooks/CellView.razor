@using MudBlazor.Extensions
@using PencilCase.Web.Pages.Notebooks.Models

<MudCard Outlined="false" Elevation="4">
    <MudCardHeader Class="mud-background-gray">
        <CardHeaderAvatar>
            <MudStack Justify="Justify.FlexStart">
                <MudIcon Icon="@Icons.Material.Rounded.QuestionAnswer" Size="Size.Large"></MudIcon>
            </MudStack>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudTextField T="string" Class="ma-0" AutoGrow="true" Margin="Margin.Dense"
                          OnKeyDown="OnKeyDown" @ref="_inputTextField"
                          DebounceInterval="2500" MaxLength="250" Disabled="@_isLoading"
                          Typo="Typo.h6" Variant="Variant.Outlined" 
                          ValueChanged="OnInputValueChanged" Value="@Block.Name">
            </MudTextField>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (_isLoading)
            {
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large" Class="pa-2"/>
            }
            else
            {
                <MudFab StartIcon="@Icons.Material.Rounded.PlayArrow" Size="Size.Large"
                        Color="Color.Secondary" OnClick="OnSubmitClick"
                        Class="ma-4">
                </MudFab>
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudStack Spacing="4">
            <MudPaper Height="150" Outlined="false" Elevation="0" Class="pa-4">
                <MudText>ASCII, short for American Standard Code for Information Interchange, is a character encoding standard used to represent text in computers and other devices that handle text.
                    <br/>
                    It was developed in the 1960s and became widely adopted as a standard for communication between different systems.</MudText>
            </MudPaper>
        </MudStack>
    </MudCardContent>
    <MudCardActions>
        <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Rounded.ArrowForward"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Rounded.Delete"></MudIconButton>
    </MudCardActions>
</MudCard>

@code {
    bool _isLoading = false;
    bool _hasChildren = false;
    
    [Parameter] public BlockViewModel? Block { get; set; }
    [Parameter] public IBlocksApi BlocksApi { get; set; } = null!;
    [Parameter] public EventCallback? OnNewCellShortcut { get; set; }

    MudTextField<string> _inputTextField = null!;
    
    async Task OnInputValueChanged(string newValue)
    {
        if (Block is not null)
        {
            Block.Name = newValue.Trim();
            await UpdateChangesTo(Block);
        }
    }

    async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.CtrlKey && args.Key=="Enter")
        {
            await _inputTextField.BlurAsync();
            GenerateOutputIfPossible();
        }

        if (args.ShiftKey && args.Key == "Enter")
        {
            Console.WriteLine("Creating new cell");
            if(OnNewCellShortcut is not null) await OnNewCellShortcut.As<EventCallback>().InvokeAsync();
        }
    }
    
    async Task OnSubmitClick()
    {
        await _inputTextField.BlurAsync();
        await GenerateOutputIfPossible();
    }
    
    async Task GenerateOutputIfPossible()
    {
        Console.WriteLine($"Generating output...");
    }

    async Task UpdateChangesTo(BlockViewModel block)
    {
        await BlocksApi.UpdateBlock(block);
    }
}