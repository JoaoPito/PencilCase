@using PencilCase.Web.Pages.Notebooks.Models
<MudPaper Outlined="true">
    <MudPaper Class="mud-background-gray blueprint-dots pa-4">
        <MudStack Spacing="4">

            <!-- Cell -->
            @foreach (var child in _children)
            {
                <CellView BlocksApi="BlocksApi" Block="child" />
            }
            
            <!-- Add new -->
            <MudStack Row="true"
                      AlignItems="AlignItems.Center" Justify="Justify.Center">
                <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled">
                    <MudIconButton Icon="@Icons.Material.Rounded.Add" Size="Size.Large"/>
                    <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
                        <MudMenuItem>Cell</MudMenuItem>
                        <MudMenuItem>Source</MudMenuItem>
                    </MudMenu>
                </MudButtonGroup>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudPaper>

@code {
    [CascadingParameter(Name = "block")] protected BlockViewModel? Block { get; set; }
    [Parameter] public IBlocksApi BlocksApi { get; set; } = null!;
    IEnumerable<BlockViewModel> _children = new List<BlockViewModel>();

    protected override async Task OnInitializedAsync()
    {
        if(Block is not null)
            _children = await BlocksApi.LoadAllAsync(Block.ChildrenIds);
    }
}