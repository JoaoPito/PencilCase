@using PencilCase.Shared.DTOs.Requests.Llm
@using PencilCase.Shared.DTOs.Requests.Rag
@using PencilCase.Shared.Models.LLM.Agents
@using PencilCase.Shared.Models.LLM.RAG
@using PencilCase.Shared.Models.Notebooks
@using PencilCase.Web.Pages.Notebooks.Models
@using PencilCase.Web.Services.LLM
@using PencilCase.Web.Services.Notebooks
@inject ILlmApi LlmApi

<MudPaper Outlined="true">
    <MudPaper Class="mud-background-gray blueprint-dots pa-4">
        <MudStack Spacing="4">

            <!-- Cell -->
            @foreach (var child in _children.OrderBy(c => c.Properties.Order))
            {
                <CellView Block="child" 
                          BlocksApi="BlocksApi"
                          RagSearchAsync="SearchForDocuments"
                          InvokeLlmAsync="InvokeLlm"
                          OnNewCellShortcut="@OnAddCellShortcut"
                          />
            }
            
            <!-- Add new -->
            <MudStack Row="true"
                      AlignItems="AlignItems.Center" Justify="Justify.Center">
                <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled">
                    <MudIconButton Icon="@Icons.Material.Rounded.Add" Size="Size.Large" OnClick="OnAddCellClicked"/>
                    <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
                        <MudMenuItem>Question</MudMenuItem>
                        <MudMenuItem>Document Search</MudMenuItem>
                        <MudMenuItem>Web Search</MudMenuItem>
                    </MudMenu>
                </MudButtonGroup>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudPaper>

@code {
    [CascadingParameter(Name = "block")] protected BlockViewModel? Block { get; set; }
    [Parameter] public IBlocksApi BlocksApi { get; set; } = null!;
    IEnumerable<BlockViewModel> _children = new List<BlockViewModel>();

    protected override async Task OnInitializedAsync()
    {
        await LoadChildren();
    }

    private async Task LoadChildren()
    {
        if (Block is not null)
        {
            var childrenList = await BlocksApi.GetChildren(Block.Id);
            _children = childrenList
                .OrderBy(c => c.Properties.LastModified)
                .ThenBy(c => c.Properties.Order);
            
            StateHasChanged();
        }
    }

    async Task<IEnumerable<RagDocument>> SearchForDocuments(string query)
    {
        var request = new RagSearchRequest()
        {
            NotebookId = Block!.Id,
            Content = query,
            FilterIds = null
        };

        var results = await LlmApi.QueryRagDocumentsAsync(request);
        return results;
    }

    async Task<IEnumerable<LlmMessage>> InvokeLlm(string query, IEnumerable<RagDocument> docs)
    {
        var userMsg = new LlmMessage()
        {
            Role = "user",
            Content = query
        };
        
        var request = new LlmMessageInvokeRequest()
        {
            ChatMessages = new List<LlmMessage>()
        };

        var docsList = docs.ToList();
        
        if(docsList.Any())
            request.ChatMessages.Add(ConvertDocsToLlmMessage(docsList));
        
        request.ChatMessages.Add(userMsg);
        
       return await LlmApi.InvokeLlmAgentAsync(request);
    }

    private LlmMessage ConvertDocsToLlmMessage(IEnumerable<RagDocument> docs)
    {
        var msgs = new LlmMessage()
        {
            Role = "user",
            Content = docs
                .Select(d => d.Content)
                .Aggregate((acc, content) => acc + $"\n## INFO\n \"{content}\"\n")
        };
        return msgs;
    }

    private async Task OnAddCellShortcut() => await AddNewCell();
    private async Task OnAddCellClicked() => await AddNewCell();
    
    private async Task AddNewCell()
    {
        var lastBlock = _children
            .OrderBy(c => c.Properties.Order)
            .LastOrDefault();

        var order = 0;
        if (lastBlock is not null)
            order = lastBlock.Properties.Order + 1;

        var newCell = new BlockViewModel()
        {
            Name = "",
            ParentId = Block!.Id,
            Type = BlockType.Cell,
            Properties = new BlockPropertiesViewModel()
            {
                CellType = CellType.Question,
                Order = order
            }
        };

        await BlocksApi.AddBlock(newCell);
        await LoadChildren();
    }
}