@page "/block/{BlockId}"
@using PencilCase.Shared.Models.Notebooks
@using PencilCase.Web.Pages.Notebooks.Models
@using PencilCase.Web.Pages.Notebooks.Topics
@inject IBlocksApi BlocksApi
@inject NavigationManager NavigationManager

<PageTitle>@((_block == null) ? "pencilcase" : _block.Name)</PageTitle>

<div>
    <MudGrid Justify="Justify.Center" Class="my-4">
        <MudItem md="10" xs="12">
            <MudPaper Elevation="16" Class="pa-4">
                @if (_block is not null)
                {
                    <MudStack>
                        <MudStack Row="true" StretchItems="StretchItems.None" Justify="Justify.Center" AlignItems="AlignItems.Center">
                            <MudIconButton Size="Size.Large" Icon="@Icons.Material.Rounded.ArrowBack"
                                           Disabled="@(_block.ParentId is null)">
                            </MudIconButton>
                            <MudStack Spacing="1" AlignItems="AlignItems.Start" Class="d-flex flex-row flex-grow-1 mx-4" 
                                      StretchItems="StretchItems.None">
                                <MudStack Spacing="1" Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center">
                                    <BlockIcon Block="_block" Size="Size.Large"/>
                                    <MudText Typo="Typo.h3" Class="mx-4">@_block.Name</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Align="Align.Left">
                                    @_block.ChildrenIds.Count() item(s)
                                </MudText>
                            </MudStack>
                        </MudStack>
                        
                        <CascadingValue Value="@_block" Name="block">
                            @switch (_block.Type)
                            {
                                case BlockType.Topic:
                                    <TopicView BlocksApi=@BlocksApi RedirectTo="RedirectTo" />
                                    break;
                                case BlockType.Notebook:
                                    <MudText Typo="Typo.h5">Notebook placeholder</MudText>
                                    break;
                                case BlockType.Cell:
                                    <MudText Typo="Typo.h5">Cell placeholder</MudText>
                                    break;
                                default:
                                    <MudText Typo="Typo.h4">Ooops... Seems like something wrong happened :(</MudText>
                                    break;
                            }
                        </CascadingValue>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>

@code {
    [Parameter] public string? BlockId { get; set; } = string.Empty;
    private BlockViewModel? _block;

    protected override async Task OnParametersSetAsync()
    {
        await LoadBlock();
        StateHasChanged();
        await base.OnParametersSetAsync();
    }

    private async Task LoadBlock()
    {
        _block = (BlockId == null) ? await BlocksApi.GetLastUsedBlock() : await BlocksApi.GetBlock(Guid.Parse(BlockId));
    }

    private void RedirectTo(BlockViewModel block)
    {
        _block = block;
        NavigationManager.NavigateTo($"/block/{block.Id}", false);
        StateHasChanged();
    }
}