@page "/{BlockId}"
@using Block = PencilCase.Shared.Models.Notebooks.Block
@inject IBlocksApi BlocksApi

<PageTitle>@_block.Name</PageTitle>
<h1>@_block.Name</h1>
<h4>Type: @_block.Type</h4>
<p>@_block.Children.Count()</p>
<MudStack>
    @foreach (var child in _block.Children)
    {
        <MudItem><b>@child.Name</b></MudItem>
    }
</MudStack>

@code {
    [Parameter] public string BlockId { get; set; } = string.Empty;
    Block _block;
    
    

    protected override async Task OnInitializedAsync()
    {
        _block = (BlockId == null) ? await BlocksApi.GetLastUsedBlock() : await BlocksApi.GetBlock(Guid.Parse(BlockId));
        await base.OnInitializedAsync();
    }

}