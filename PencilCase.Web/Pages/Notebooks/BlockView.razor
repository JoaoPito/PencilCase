@page "/block/{BlockId}"
@using PencilCase.Shared.Models.Notebooks
@using PencilCase.Web.Pages.Notebooks.Models
@inject IBlocksApi BlocksApi
@inject NavigationManager NavigationManager

<PageTitle>@((_block == null) ? "pencilcase" : _block.Name)</PageTitle>
<div class="pa-4">
    @if (_block is not null)
    {
        @switch (_block.Type)
        {
            case BlockType.Topic:
                <TopicView Block="_block" BlocksApi=@BlocksApi RedirectToBlock="RedirectTo"/>
                break;
            case BlockType.Notebook:
                <MudText Typo="Typo.h5">Notebook placeholder</MudText>
                break;
            case BlockType.Cell:
                <MudText Typo="Typo.h5">Cell placeholder</MudText>
                break;
            default:
                <MudText Typo="Typo.h4">Ooops... Seems like something wrong happened :(</MudText>
                break;
        }
    }
</div>


@code {
    [Parameter] public string? BlockId { get; set; } = string.Empty;
    BlockViewModel? _block = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadBlock();
        await base.OnInitializedAsync();
    }

    private async Task LoadBlock()
    {
        _block = (BlockId == null) ? await BlocksApi.GetLastUsedBlock() : await BlocksApi.GetBlock(Guid.Parse(BlockId));
    }

    private void RedirectTo(BlockViewModel block)
    {
        NavigationManager.NavigateTo($"/block/{block.Id}", forceLoad: true);
        _block = block;
        StateHasChanged();
    }
}