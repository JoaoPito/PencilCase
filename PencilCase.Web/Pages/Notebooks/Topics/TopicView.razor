@using PencilCase.Web.Pages.Notebooks.Models
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    .selected {
        background-color: var(--mud-palette-primary, #1E88E5) !important;
    }
    .selected > td {
        color: white !important;
    }
    .selected > td .mud-input {
        color: white !important;
    }
</style>

@if (Block is not null)
{
    <!-- Toolbar -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd"
              Spacing="2"
              Style="border: 2px red solid">
        <MudIconButton Icon="@Icons.Material.Rounded.CloudUpload" Size="Size.Medium"
                       OnClick="OnAddSourceClicked"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Rounded.CreateNewFolder" Size="Size.Medium"
                       OnClick="OnAddTopicClicked"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Rounded.NoteAdd" Size="Size.Medium"
                       OnClick="OnAddNotebookClicked"></MudIconButton>
    </MudStack>
    <!-- Table -->
    <MudTable Items="@_blockChildren" Hover="true" T="BlockViewModel" @ref="_blocksTable" Loading="@_isLoading"
              OnRowClick="RowClickEvent" RowClass="cursor-pointer" RowClassFunc="@SelectedRowClassFunc"
              SortLabel="Sort By" AllowUnsorted="false"
              EditTrigger="TableEditTrigger.EditButton"
              ApplyButtonPosition="TableApplyButtonPosition.End" EditButtonPosition="TableEditButtonPosition.End"
              CanCancelEdit="true" RowEditPreview="BackupItemBeforeEditing"
              RowEditCancel="ResetRowToOriginalValues" RowEditCommit="OnRowEditCommit"
              Elevation="0" LoadingProgressColor="Color.Secondary">

        <HeaderContent>
            <MudTh> </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<BlockViewModel, object>(x => x.Name)"
                                   T="BlockViewModel">
                    Name
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<BlockViewModel, object>(x => x.Type)"
                                   T="BlockViewModel">
                    Type
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<BlockViewModel, object>(x => x.Properties.LastModified)"
                                   T="BlockViewModel"
                                   InitialDirection="SortDirection.Descending">
                    Date
                </MudTableSortLabel>
            </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel=" " Style="text-align:center">
                <BlockIcon Block="context" Size="Size.Medium"/>
            </MudTd>
            <MudTd DataLabel="Name">
                <MudText>
                    <b>@context.Name</b>
                </MudText>
            </MudTd>
            <MudTd DataLabel="Type">
                <MudText Typo="Typo.body2">@context.Type</MudText>
            </MudTd>
            <MudTd DataLabel="Date">
                <MudText Typo="Typo.body2">@context.Properties.LastModified.ToLocalTime()</MudText>
            </MudTd>
        </RowTemplate>

        <RowEditingTemplate>
            <MudTd DataLabel=" " Style="text-align:center">
                <BlockIcon Block="context" Size="Size.Medium"/>
            </MudTd>
            <MudTd DataLabel="Name">
                <MudTextField @bind-Value="context.Name" Required MaxLength="50"></MudTextField>
            </MudTd>
            <MudTd DataLabel="Type">
                <MudText Typo="Typo.body2">@context.Type</MudText>
            </MudTd>
            <MudTd DataLabel="Date">
                <MudText Typo="Typo.body2">@context.Properties.LastModified.ToLocalTime()</MudText>
            </MudTd>
        </RowEditingTemplate>

        <EditButtonContent Context="button">
            <MudIconButton Size="@Size.Medium" Icon="@Icons.Material.Rounded.Edit"
                           Class="pa-1" OnClick="@button.ButtonAction" Disabled="@(button.ButtonDisabled || _isLoading)"/>
            <MudIconButton Size="@Size.Medium" Icon="@Icons.Material.Rounded.Delete" Color="Color.Error"
                           Class="pa-1" OnClick="@(() => OnDeleteClicked(button))" Disabled="@(button.ButtonDisabled || _isLoading)"/>
        </EditButtonContent>

        <NoRecordsContent>
            <MudText Typo="Typo.h5" Class="pt-10">It's empty here...</MudText>
            <MudText Typo="Typo.body1" Class="pb-10">You can add items using the buttons above.</MudText>
        </NoRecordsContent>

    </MudTable>
}
else
{
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true"/>
}

