@using PencilCase.Web.Pages.Notebooks.Models
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (Block is not null)
{
    <MudGrid Justify="Justify.Center" Class="my-4">
        <MudItem xs="12" md="10">
            <MudTable ServerData="ServerReload" Hover="true" T="BlockViewModel" @ref="_blocksTable"
                      OnRowClick="RowClickEvent" RowClass="cursor-pointer"
                      SortLabel="Sort By" AllowUnsorted="false"
                      EditTrigger="TableEditTrigger.EditButton" 
                      ApplyButtonPosition="TableApplyButtonPosition.End" EditButtonPosition="TableEditButtonPosition.End"
                      CanCancelEdit="true" RowEditPreview="BackupItemBeforeEditing"
                      RowEditCancel="ResetRowToOriginalValues" RowEditCommit="OnRowEditCommit"
                      Elevation="16" LoadingProgressColor="Color.Secondary" >
                <ToolBarContent>
                    <BlockIcon Block="Block" Size="Size.Large" />
                    <MudText Typo="Typo.h3" Class="mx-4">@Block.Name</MudText>
                    <MudText Typo="Typo.body2" Class="mx-4">@Block.ChildrenIds.Count() item(s)</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Rounded.CloudUpload" Size="Size.Medium"
                                   OnClick="OnAddSourceClicked"></MudIconButton>
                    <MudIconButton Icon="@Icons.Material.Rounded.NoteAdd" Size="Size.Medium"
                                   OnClick="OnAddNotebookClicked"></MudIconButton>
                    <MudIconButton Icon="@Icons.Material.Rounded.CreateNewFolder" Size="Size.Medium"
                                   OnClick="OnAddTopicClicked"></MudIconButton>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh> </MudTh>
                    <MudTh><MudTableSortLabel SortLabel="name" T="BlockViewModel">Name</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="type" T="BlockViewModel">Type</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="modified-at" T="BlockViewModel" InitialDirection="SortDirection.Descending">Date</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel=" " Style="text-align:center">
                        <BlockIcon Block="context" Size="Size.Medium" />
                    </MudTd>
                    <MudTd DataLabel="Name"><MudText><b>@context.Name</b></MudText></MudTd>
                    <MudTd DataLabel="Type"><MudText Typo="Typo.body2">@context.Type</MudText></MudTd>
                    <MudTd DataLabel="Date"><MudText Typo="Typo.body2">@context.Properties.LastModified.ToLocalTime()</MudText></MudTd>
                </RowTemplate>
                <RowEditingTemplate>
                    <MudTd DataLabel=" " Style="text-align:center">
                        <BlockIcon Block="context" Size="Size.Medium" />
                    </MudTd>
                    <MudTd DataLabel="Name">
                        <MudTextField @bind-Value="context.Name" Required MaxLength="50"></MudTextField>
                    </MudTd>
                    <MudTd DataLabel="Type"><MudText Typo="Typo.body2">@context.Type</MudText></MudTd>
                    <MudTd DataLabel="Date"><MudText Typo="Typo.body2">@context.Properties.LastModified.ToLocalTime()</MudText></MudTd>
                </RowEditingTemplate>
                <EditButtonContent Context="button">
                    <MudIconButton Size="@Size.Medium" Icon="@Icons.Material.Rounded.Edit" 
                                   Class="pa-1" OnClick="@button.ButtonAction" Disabled="@button.ButtonDisabled" />
                    <MudIconButton Size="@Size.Medium" Icon="@Icons.Material.Rounded.Delete" Color="Color.Error" 
                                   Class="pa-1" OnClick="@(() => OnDeleteClicked(button))" Disabled="@button.ButtonDisabled" />
                </EditButtonContent>
                <NoRecordsContent>
                    <MudText Typo="Typo.h5" Class="pt-10">It's empty here...</MudText>
                    <MudText Typo="Typo.body1" Class="pb-10">You can add items using the buttons above.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudItem>
    </MudGrid>
}
else
{
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true"/>
}

