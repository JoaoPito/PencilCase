@using PencilCase.Shared.DTOs.Responses.Blocks
@using PencilCase.Shared.Models.Notebooks
@inject NavigationManager NavigationManager

@if (Block is not null)
{
    <MudGrid Justify="Justify.Center">
        <MudItem xs="12" md="10">
            <MudTable Items="@_blockChildren" Hover="true" T="BlockResponse"
                      Loading="@_loading" LoadingProgressColor="Color.Secondary"
                      OnRowClick="RowClickEvent" SortLabel="Sort By"
                      Breakpoint="Breakpoint.Sm" Elevation="16">
                <ToolBarContent>
                    <BlockIcon Block="Block" Size="Size.Large" />
                    <MudText Typo="Typo.h3" Class="mx-4">@Block.Name</MudText>
                    <MudSpacer />
                    <MudText Typo="Typo.body2" Class="mx-4">@Block.ChildrenIds.Count() item(s)</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh> </MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<BlockResponse, object>(x=>x.Name)">Name</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<BlockResponse, object>(x=>x.Type)">Type</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<BlockResponse, object>(x=>x.Properties.LastModified)"></MudTableSortLabel>Date</MudTh>
                    <MudTh>Options</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel=" " Style="text-align:center">
                        <BlockIcon Block="context" />
                    </MudTd>
                    <MudTd DataLabel="Name"><MudText><b>@context.Name</b></MudText></MudTd>
                    <MudTd DataLabel="Type"><MudText Typo="Typo.body2">@context.Type</MudText></MudTd>
                    <MudTd DataLabel="Date"><MudText Typo="Typo.body2">@context.Properties.LastModified.ToLocalTime()</MudText></MudTd>
                    <MudTd DataLabel="Options"><MudIconButton Icon="@Icons.Material.Rounded.MoreHoriz"/></MudTd>
                </RowTemplate>
            </MudTable>
        </MudItem>
    </MudGrid>
}
else
{
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true"/>
}

@code {
    private IEnumerable<BlockResponse> _blockChildren = new List<BlockResponse>();
    [Parameter] public BlockResponse? Block { get; set; } = null;
    [Parameter] public IBlocksApi BlocksApi { get; set; } = null!;
    bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (Block is not null)
        {
            _loading = true;
            _blockChildren = await BlocksApi.LoadAllAsync(Block.ChildrenIds);
            _loading = false;
        }
        await base.OnInitializedAsync();
    }

    void RedirectToBlock(BlockResponse block)
    {
        NavigationManager.NavigateTo($"/block/{block.Id}", true);
    }

    private void RowClickEvent(TableRowClickEventArgs<BlockResponse> tableRowClickEventArgs)
    {
        var block = tableRowClickEventArgs.Item;
        if (block is not null)
            RedirectToBlock(block);
    }
}