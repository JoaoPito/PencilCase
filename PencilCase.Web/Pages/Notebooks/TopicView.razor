@using PencilCase.Shared.DTOs.Responses.Blocks
@using PencilCase.Shared.Models.Notebooks

@if (Block is not null)
{
    <MudTable Items="@_blockChildren" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Secondary">
        <HeaderContent>
            <MudTh>Type</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Last Modified</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Type">@switch (context.Type)
                                    {
                                        case BlockType.Notebook:
                                            <MudIcon Icon="@Icons.Material.Rounded.InsertDriveFile"></MudIcon>
                                            break;
                                        case BlockType.Cell:
                                            <MudIcon Icon="@Icons.Material.Rounded.TextSnippet"></MudIcon>
                                            break;
                                        default:
                                            <MudIcon Icon="@Icons.Material.Rounded.Folder"></MudIcon>
                                            break;
                                    }</MudTd>
            <MudTd DataLabel="Name"><MudText><b>@context.Name</b></MudText></MudTd>
            <MudTd DataLabel="Date">@context.Properties.LastModified</MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true"/>
}

@code {
    private IEnumerable<BlockResponse> _blockChildren = new List<BlockResponse>();
    [Parameter] public BlockResponse? Block { get; set; } = null;
    [Parameter] public IBlocksApi BlocksApi { get; set; } = null!;
    bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (Block is not null)
        {
            _loading = true;
            _blockChildren = await BlocksApi.LoadAllAsync(Block.ChildrenIds);
            _loading = false;
        }
        await base.OnInitializedAsync();
    }

}