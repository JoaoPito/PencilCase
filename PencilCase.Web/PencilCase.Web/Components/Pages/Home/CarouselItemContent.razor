<div class="d-flex pa-12 align-center" style="height:100%">
    <MudGrid Justify="Justify.SpaceAround">
        <MudItem xs="6">
            <MudText Align="Align.Left" Typo="Typo.h2">@Title</MudText>
            <MudText Align="Align.Left" Typo="Typo.h4">@Subtitle</MudText>
            @if (Body is not null)
            {
                <MudText Align="Align.Left" Typo="Typo.body1" Class="my-4">@Body</MudText>
            }
            <MudButton Style="background-color: rgb(255 255 255 / 66%); color: black"
                       DropShadow="false"
                       FullWidth="false"
                       Size="Size.Large"
                       Variant="Variant.Filled"
                       Class="my-6 px-10 rounded-lg"
                       Href="@ButtonHref">
                @Button
            </MudButton>
        </MudItem>
        <MudItem xs="6">
            <MudImage Src="@Image" Fluid="true" ObjectFit="ObjectFit.Fill"></MudImage>
        </MudItem>
    </MudGrid>
</div>
@code {
    [Parameter] public string Title { get; set; } = String.Empty;
    [Parameter] public string Subtitle { get; set; } = String.Empty;
    [Parameter] public string? Body { get; set; }
    [Parameter] public string Button { get; set; } = String.Empty;
    [Parameter] public string? ButtonHref { get; set; }
    [Parameter] public string Image { get; set; } = String.Empty;
}